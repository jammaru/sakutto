     auto & cur_p = gsmpl->cur_p; // initialized by set_logits
 
+    // The chain would pick the largest logit. Find it in the logits instead: on a large vocabulary,
+    // building the candidate array and passing it through the chain costs several times the scan.
+    if (common_sampler_takes_max(gsmpl, ctx)) {
+        const float * logits  = llama_get_logits_ith(ctx, idx);
+        const int     n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(ctx)));
+        GGML_ASSERT(logits != nullptr);
+
+        // The largest value stays in a local: reading logits[id] back on every step would put a
+        // memory load into the chain that each step waits for.
+        float max_logit = logits[0];
+        id = 0;
+        for (llama_token token_id = 1; token_id < n_vocab; token_id++) {
+            if (logits[token_id] > max_logit) {
+                max_logit = logits[token_id];
+                id        = token_id;
+            }
+        }
+
+        gsmpl->cur.assign(1, llama_token_data{ id, max_logit, 0.0f });
+        cur_p = { gsmpl->cur.data(), gsmpl->cur.size(), 0, false };
+
+        return id;
+    }
+
     gsmpl->set_logits(ctx, idx);
 
