+// True when the chain built by common_sampler_init() can only return the token with the largest logit.
+static bool common_sampler_takes_max(const struct common_sampler * gsmpl, const struct llama_context * ctx) {
+    const auto & params = gsmpl->params;
+
+    if (gsmpl->grmr || gsmpl->rbudget || params.backend_sampling || params.mirostat != 0 || params.n_probs != 0 ||
+        params.samplers.empty() || !params.logit_bias.empty()) {
+        return false;
+    }
+
+    // The model's suppress tokens add a logit bias to the chain.
+    int32_t n_suppress = 0;
+    llama_vocab_get_suppress_tokens(llama_model_get_vocab(llama_get_model(ctx)), &n_suppress);
+    if (n_suppress > 0) {
+        return false;
+    }
+
+    // The same test as in common_sampler_init(): the chain ends in the greedy sampler.
+    const auto last = params.samplers.back();
+    if (!((last == COMMON_SAMPLER_TYPE_TEMPERATURE && params.temp == 0.0f && params.dynatemp_range == 0.0f) ||
+          (last == COMMON_SAMPLER_TYPE_TOP_K && params.top_k == 1))) {
+        return false;
+    }
+
+    // Every sampler before it must keep the largest logit and must not move another one above it.
+    for (const auto type : params.samplers) {
+        switch (type) {
+            case COMMON_SAMPLER_TYPE_TOP_K:
+            case COMMON_SAMPLER_TYPE_TOP_P:
+            case COMMON_SAMPLER_TYPE_MIN_P:
+            case COMMON_SAMPLER_TYPE_TOP_N_SIGMA:
+                break;
+            case COMMON_SAMPLER_TYPE_TEMPERATURE:
+                // A temperature above zero divides the logits, and two of them can round to the same value.
+                if (params.temp > 0.0f || params.dynatemp_range != 0.0f) {
+                    return false;
+                }
+                break;
+            case COMMON_SAMPLER_TYPE_PENALTIES:
+                if (params.penalty_last_n != 0 &&
+                    (params.penalty_repeat != 1.0f || params.penalty_freq != 0.0f || params.penalty_present != 0.0f)) {
+                    return false;
+                }
+                break;
+            case COMMON_SAMPLER_TYPE_DRY:
+                if (params.dry_multiplier != 0.0f) {
+                    return false;
+                }
+                break;
+            case COMMON_SAMPLER_TYPE_TYPICAL_P:
+                if (params.typ_p < 1.0f) {
+                    return false;
+                }
+                break;
+            case COMMON_SAMPLER_TYPE_XTC:
+                if (params.xtc_probability > 0.0f) {
+                    return false;
+                }
+                break;
+            default:
+                return false;
+        }
+    }
+
+    return true;
+}
+
 llama_token common_sampler_sample(struct common_sampler * gsmpl, struct llama_context * ctx, int idx, bool grammar_first) {
     llama_synchronize(ctx);
 
