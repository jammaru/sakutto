+// True for this backend's device when its adapter vendor is "nvidia". The backend
+// argmax of llama_set_argmax_only() is NVIDIA-measured only.
+bool ggml_backend_webgpu_dev_is_nvidia(ggml_backend_dev_t dev) {
+    if (dev == nullptr || dev->iface.get_name == nullptr || dev->context == nullptr) {
+        return false;
+    }
+    const char * name = dev->iface.get_name(dev);
+    if (name == nullptr || std::string(name) != GGML_WEBGPU_NAME) {
+        return false;
+    }
+    ggml_backend_webgpu_device_context * ctx = static_cast<ggml_backend_webgpu_device_context *>(dev->context);
+    return ctx->webgpu_global_ctx != nullptr && ctx->webgpu_global_ctx->vendor == "nvidia";
+}
