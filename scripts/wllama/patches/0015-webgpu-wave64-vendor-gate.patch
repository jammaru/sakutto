+// True for this backend's device when its adapter is AMD/ATI hardware, which
+// ggml_webgpu_adapter_is_amd() recognizes. The safe kernels of the v1.3.0 build
+// stay on that hardware; every other vendor keeps the fast paths.
+bool ggml_backend_webgpu_dev_is_amd(ggml_backend_dev_t dev) {
+    if (dev == nullptr || dev->iface.get_name == nullptr || dev->context == nullptr) {
+        return false;
+    }
+    const char * name = dev->iface.get_name(dev);
+    if (name == nullptr || std::string(name) != GGML_WEBGPU_NAME) {
+        return false;
+    }
+    ggml_backend_webgpu_device_context * ctx = static_cast<ggml_backend_webgpu_device_context *>(dev->context);
+    return ctx->webgpu_global_ctx != nullptr &&
+           ggml_webgpu_adapter_is_amd(ctx->webgpu_global_ctx->vendor, ctx->webgpu_global_ctx->architecture);
+}
