@@ -73,6 +73,27 @@ inline bool ggml_webgpu_tensor_equal(const ggml_tensor * a, const ggml_tensor *
     return a->buffer == b->buffer && ggml_webgpu_tensor_addr(a) == ggml_webgpu_tensor_addr(b);
 }
 
+// True when the adapter is AMD/ATI hardware: an "amd"/"ati" vendor string
+// (case-insensitive), or an architecture Dawn reports as "gcn-*", "rdna-*", "gfx*".
+// Wave64 subgroup ops on that hardware have miscompiled before, so the safe
+// kernels of the v1.3.0 build stay on it; every other vendor keeps the fast paths.
+inline bool ggml_webgpu_adapter_is_amd(const std::string & vendor, const std::string & architecture) {
+    std::string v;
+    v.reserve(vendor.size());
+    for (const char c : vendor) {
+        v.push_back(c >= 'A' && c <= 'Z' ? (char) (c - 'A' + 'a') : c);
+    }
+    if (v == "amd" || v == "ati") {
+        return true;
+    }
+    std::string a;
+    a.reserve(architecture.size());
+    for (const char c : architecture) {
+        a.push_back(c >= 'A' && c <= 'Z' ? (char) (c - 'A' + 'a') : c);
+    }
+    return a.rfind("gcn-", 0) == 0 || a.rfind("rdna-", 0) == 0 || a.rfind("gfx", 0) == 0;
+}
