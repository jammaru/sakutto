{
  "name": "sakutto",
  "version": "1.9.1",
  "private": true,
  "description": "Local web page translation with PLaMo 3 Translate.",
  "license": "MIT",
  "author": "jammaru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jammaru/sakutto.git"
  },
  "homepage": "https://github.com/jammaru/sakutto",
  "bugs": {
    "url": "https://github.com/jammaru/sakutto/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "node scripts/sync-ocr-runtime.mjs && node scripts/sync-pdfjs.mjs && node scripts/sync-licenses.mjs && wxt",
    "build": "node scripts/sync-ocr-runtime.mjs && node scripts/verify-wllama.mjs && node scripts/sync-pdfjs.mjs && node scripts/sync-licenses.mjs && wxt build",
    "build:firefox": "node scripts/sync-ocr-runtime.mjs && node scripts/verify-wllama.mjs && node scripts/sync-pdfjs.mjs && node scripts/sync-licenses.mjs && wxt build -b firefox",
    "zip": "node scripts/sync-ocr-runtime.mjs && node scripts/verify-wllama.mjs && node scripts/sync-pdfjs.mjs && node scripts/sync-licenses.mjs && wxt zip && node scripts/verify-package.ts",
    "zip:firefox": "node scripts/sync-ocr-runtime.mjs && node scripts/verify-wllama.mjs && node scripts/sync-pdfjs.mjs && node scripts/sync-licenses.mjs && wxt zip -b firefox && node scripts/verify-package.ts --browser firefox",
    "source:firefox": "node scripts/amo-source-package.ts",
    "lint:firefox": "node scripts/web-ext-lint.ts",
    "icons": "node scripts/generate-icons.mjs",
    "build:wllama": "node scripts/wllama/build.ts",
    "wllama:check": "node scripts/wllama/build.ts --check",
    "verify:wllama": "node scripts/verify-wllama.mjs",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/sync-ocr-runtime.mjs && node scripts/sync-licenses.mjs && node scripts/sync-pdfjs.mjs && wxt prepare && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run --configLoader runner",
    "test:e2e": "node scripts/run-e2e.mjs",
    "caption:quality": "node scripts/run-e2e.mjs -- e2e/caption-quality.spec.ts e2e/caption-quality-json3.spec.ts",
    "caption:quality:json3": "node scripts/run-e2e.mjs -- e2e/caption-quality-json3.spec.ts",
    "bench": "node scripts/bench/run.ts",
    "bench:mock": "node scripts/bench/pages-run.ts --mode mock",
    "bench:live": "node scripts/bench/pages-run.ts --mode live",
    "bench:build:mock": "node scripts/sync-pdfjs.mjs && node scripts/sync-licenses.mjs && SAKUTTO_FAKE_ENGINE=1 wxt build",
    "bench:build:live": "node scripts/sync-ocr-runtime.mjs && node scripts/verify-wllama.mjs && node scripts/sync-pdfjs.mjs && node scripts/sync-licenses.mjs && SAKUTTO_E2E_REAL=1 wxt build",
    "bench:serve": "node scripts/bench/static.ts",
    "bench:history": "node scripts/bench/report.ts",
    "bench:download": "node --experimental-strip-types --no-warnings --import ./scripts/bench/register-ts.mjs scripts/bench/download-throughput.ts",
    "bench:equality": "node --experimental-strip-types --no-warnings --import ./scripts/bench/register-ts.mjs scripts/bench/translation-equality.ts",
    "bench:sha256": "node --experimental-strip-types --no-warnings --import ./scripts/bench/register-ts.mjs scripts/bench/sha256-throughput.ts",
    "i18n:check": "node scripts/i18n/check-locales.mjs",
    "i18n:draft": "node scripts/i18n/generate-locale.mjs",
    "release": "node scripts/release/cli.ts",
    "pdfjs": "node scripts/sync-pdfjs.mjs",
    "bench:pdf": "node scripts/bench/pdf-run.ts",
    "bench:ocr": "node --experimental-strip-types --no-warnings --import ./scripts/bench/register-ts.mjs scripts/bench/ocr-run.ts",
    "bench:ocr:render": "node --experimental-strip-types --no-warnings --import ./scripts/bench/register-ts.mjs scripts/bench/ocr-render.ts",
    "bench:pdf:layout": "node --experimental-strip-types --no-warnings --import ./scripts/bench/register-ts.mjs scripts/bench/pdf-layout.ts",
    "bench:pdf:quality": "node --experimental-transform-types --no-warnings --import ./scripts/bench/register-ts.mjs scripts/bench/pdf-quality.ts",
    "bench:pdf:quality:scan": "pnpm bench:pdf:scan:ocr && pnpm bench:pdf:quality",
    "bench:ocr:lab": "node --experimental-transform-types --no-warnings --import ./scripts/bench/register-ts.mjs scripts/bench/ocr-lab.ts",
    "bench:pdf:scan:ocr": "node --experimental-transform-types --no-warnings --import ./scripts/bench/register-ts.mjs scripts/bench/pdf-scan-ocr.ts",
    "bench:pdf:scan:gt": "node --experimental-transform-types --no-warnings --import ./scripts/bench/register-ts.mjs scripts/bench/build-scan-gt.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.10.0",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.58.1",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.7",
    "vitest": "^5.1.1",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "onnxruntime-web": "1.31.1",
    "pdfjs-dist": "4.10.38"
  }
}
