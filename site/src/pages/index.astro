---
import SakuttoLayout from "../layouts/SakuttoLayout.astro";
import SakuttoLanding from "../components/SakuttoLanding.astro";
import { sakuttoCopy } from "../data/sakutto";

const copy = sakuttoCopy.ja;
---

<SakuttoLayout
  locale="ja"
  title={copy.meta.title}
  description={copy.meta.description}
  ogAlt={copy.meta.ogAlt}
>
  <SakuttoLanding locale="ja" />
</SakuttoLayout>
