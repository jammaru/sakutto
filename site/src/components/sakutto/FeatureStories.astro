---
import type { SakuttoLocale } from "../../data/sakutto";

interface Props { locale: SakuttoLocale }

const ja = Astro.props.locale === "ja";
const lang = ja ? "ja" : "en";

const source = ja
  ? {
      code: "EN",
      running: "FIELD BOTANY",
      title: "Japanese indigo",
      body: "The leaves yield a deep blue dye.",
    }
  : {
      code: "JA",
      running: "植物図譜",
      title: "タデアイ",
      body: "葉から藍色の染料が得られる。",
    };
const target = ja
  ? {
      code: "JA",
      running: "植物図譜",
      title: "タデアイ",
      body: "葉から藍色の染料が得られる。",
    }
  : {
      code: "EN",
      running: "FIELD BOTANY",
      title: "Japanese indigo",
      body: "The leaves yield a deep blue dye.",
    };
---

<section class="stories" aria-labelledby="demo">
  <header class="stories__head">
    <h2 id="demo" lang={lang}>
      {ja ? "PDFも、字幕も、返信も。" : "From papers to subtitles to replies."}
    </h2>
  </header>

  <section class="story" id="pdf" aria-labelledby="pdf-title">
    <div class="copy">
      <h3 id="pdf-title" lang={lang}>
        {ja ? "図を見ながら、" : "Keep the figures."}<br />
        {ja ? "訳文を読む。" : "Read the translation."}
      </h3>
      <p lang={lang}>
        {ja
          ? "PDFの段組みや図表の位置を保ったまま翻訳。左右に並べた原文と訳文が一緒にスクロールするので、気になる一節をすぐ照らし合わせられます。"
          : "Translate a PDF while keeping its columns and illustrations in place. The original and translation scroll together, so you can check a passage against its source."}
      </p>
    </div>
    <div class="art paper-art" aria-hidden="true">
      <div class="spread">
        {[source, target].map((page) => (
          <div class="leaf" lang={page.code === "JA" ? "ja" : "en"}>
            <div class="running"><span>{page.running}</span><span>{page.code}</span></div>
            <strong>{page.title}</strong>
            <i>Persicaria tinctoria</i>
            <img
              loading="lazy"
              decoding="async"
              src="/reader/indigo-plant.webp"
              srcset="/reader/indigo-plant-320.webp 320w, /reader/indigo-plant.webp 540w"
              sizes="(max-width: 720px) 42vw, 180px"
              alt=""
              width="540"
              height="360"
            />
            <p>{page.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="story reverse" id="captions" aria-labelledby="captions-title">
    <div class="copy">
      <h3 id="captions-title" lang={lang}>
        {ja ? "映像のそばに、" : "Subtitles, right"}<br />
        {ja ? "訳した字幕を。" : "on the video."}
      </h3>
      <p lang={lang}>
        {ja
          ? "YouTubeやXの動画では、再生に合わせて字幕の訳を表示。字幕をドラッグして位置を変えられます。"
          : "On YouTube and X videos, translated captions appear as the video plays. Drag the captions to reposition them."}
      </p>
    </div>
    <div class="art film-art" aria-hidden="true">
      <picture class="demo-art">
        <img
          src="/media/story-captions-poster-720.webp"
          srcset="/media/story-captions-poster-512.webp 512w, /media/story-captions-poster-720.webp 720w"
          sizes="(max-width: 720px) 92vw, 490px"
          data-animated-src="/media/story-captions.webp"
          loading="lazy"
          decoding="async"
          alt={ja ? "映像の場面に合わせて原文と訳文の字幕が切り替わる様子" : "Original and translated captions changing as the scene changes"}
          width="720"
          height="720"
        />
      </picture>
    </div>
  </section>

  <section class="story" id="write" aria-labelledby="write-title">
    <div class="copy">
      <h3 id="write-title" lang={lang}>
        {ja ? "書いた言葉を、" : "Check your words"}<br />
        {ja ? "送る前に訳す。" : "before you send."}
      </h3>
      <p lang={lang}>
        {ja
          ? "返信欄のそばにある「あA」で、下書きの訳をプレビュー。言い回しを確かめてから、その場で置き換えられます。"
          : "Use the あA control beside a message field to preview your draft in another language. Check the wording, then replace the text in place."}
      </p>
    </div>
    <div class="art write-art" aria-hidden="true">
      <picture class="demo-art">
        <img
          src="/media/story-write-poster-720.webp"
          srcset="/media/story-write-poster-512.webp 512w, /media/story-write-poster-720.webp 720w"
          sizes="(max-width: 720px) 92vw, 490px"
          data-animated-src="/media/story-write.webp"
          loading="lazy"
          decoding="async"
          alt={ja ? "入力中の文章を翻訳し、訳文に置き換える操作" : "Previewing and replacing a draft with its translation"}
          width="720"
          height="720"
        />
      </picture>
    </div>
  </section>
</section>


<style>
  .stories {
    width: min(100%, 1060px);
    margin-inline: auto;
    padding: clamp(34px, 6vw, 86px) 0 clamp(52px, 8vw, 112px);
  }

  .stories__head {
    border-top: 1px solid var(--border);
    padding-top: clamp(18px, 2.2vw, 26px);
    /* Keep the heading clear of the first tile, including its bleed and shadow. */
    padding-bottom: clamp(48px, 7vw, 96px);
  }

  .stories h2 {
    max-width: 22ch;
    font-size: clamp(2rem, 4.7vw, 4.3rem);
    font-weight: 550;
    line-height: 1.1;
    letter-spacing: -0.045em;
    text-align: left;
    color: var(--fg);
  }

  .stories h2:lang(ja) {
    font-family: var(--sans);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }

  .story + .story { margin-top: clamp(52px, 8vw, 112px); }
  .reverse .art { grid-area: 1 / 1; }
  .reverse .copy { grid-column: 2; }

  .copy { min-width: 0; max-width: 25rem; color: var(--fg); }

  .copy h3 {
    margin: 0;
    font-size: clamp(1.8rem, 3.15vw, 2.9rem);
    font-weight: 550;
    letter-spacing: -0.04em;
    line-height: 1.17;
  }

  .copy p {
    margin-top: 1.25rem;
    font-size: 1.025rem;
    line-height: 1.85;
    color: var(--muted);
  }

  /* One radius system for every tile: inner panels are the outer radius minus padding. */
  .art {
    --tile-radius: 24px;
    --tile-pad: 16px;
    --panel-radius: calc(var(--tile-radius) - var(--tile-pad));
    --indigo-a: #1b4360;
    --indigo-b: #102d45;
    --tile-shadow: 0 18px 44px rgb(8 27 44 / 0.16);
    --panel-shadow: 0 10px 24px rgb(6 22 36 / 0.22);
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--tile-radius);
    box-shadow: var(--tile-shadow);
    color-scheme: only light;
    container-type: inline-size;
    background-color: var(--indigo-b);
    /* Low-contrast weave over indigo-dyed cloth; no rainbow mesh. */
    background-image:
      repeating-linear-gradient(0deg, rgb(255 255 255 / 0.035) 0 1px, transparent 1px 5px),
      repeating-linear-gradient(90deg, rgb(3 18 32 / 0.06) 0 1px, transparent 1px 7px),
      linear-gradient(155deg, var(--indigo-a), var(--indigo-b));
  }

  .paper-art { --indigo-a: #214b69; --indigo-b: #123047; }
  .film-art { --indigo-a: #35677f; --indigo-b: #18394f; }
  .write-art { --indigo-a: #2b5874; --indigo-b: #15334c; }

  /* Motion demos sit directly on the tile: one indigo surface, no inset frame.
     The assets are transparent, so the tile's weave and theme show through. */
  .demo-art {
    position: absolute;
    inset: 0;
    display: block;
  }

  .demo-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 01 — washi spread; the single-pixel gutter is the source ↔ translation rule. */
  .spread {
    position: absolute;
    inset: 16% -7% 12% 8%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border-radius: var(--panel-radius);
    background: #b9cbd3;
    box-shadow: var(--panel-shadow);
  }

  .leaf {
    min-width: 0;
    overflow: hidden;
    background: #fffdf8;
    color: #1b2d3b;
    padding: 4.4cqw 3cqw 2.8cqw;
    font-family: Georgia, "Yu Mincho", serif;
  }

  .running {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 2.6cqw;
    padding-bottom: 1.2cqw;
    border-bottom: 1px solid #c8d4da;
    font-family: var(--display);
    font-size: 1.9cqw;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: 0.08em;
    color: #4d6473;
  }

  .running span:last-child { color: #0e7490; letter-spacing: 0.02em; }
  .leaf strong { display: block; font-size: 3.9cqw; font-weight: 600; line-height: 1.15; letter-spacing: -0.02em; }
  .leaf i { display: block; margin-top: 0.6cqw; font-size: 2.3cqw; color: #5d7482; }
  .leaf img { width: 100%; height: 30cqw; margin-top: 1cqw; object-fit: contain; }

  .leaf p {
    margin-top: 1.2cqw;
    padding-top: 1.2cqw;
    border-top: 1px solid #d5dee2;
    font-size: 2.6cqw;
    line-height: 1.45;
  }

  @media (max-width: 720px) {
    .story { grid-template-columns: 1fr; gap: 22px; }
    .copy { max-width: 32rem; }
    .reverse .copy, .reverse .art { grid-area: auto; }
    .art { max-width: 520px; margin-inline: auto; }
  }
</style>
