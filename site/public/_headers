# Hashed build assets (CSS, JS and fonts) are immutable across deploys.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Public files keep their URLs across deploys, but their content is fixed
# branding/media. A year-long immutable lifetime keeps repeat views and
# Lighthouse's cache policy check happy without any runtime requests.
/icon-16.png
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
